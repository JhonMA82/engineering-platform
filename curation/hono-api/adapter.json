{
  "schema_version": 1,
  "boilerplate_id": "hono-api",
  "reviewed_at": "2026-08-31",
  "source": {
    "repository": "https://github.com/JhonMA82/api-starter",
    "branch": "main",
    "commit": "360eb274cc5936fee5aab88eb8bd94977e95dfc9",
    "license": "MIT",
    "package": "api-starter@0.12.2"
  },
  "requirements": [
    {"executable": "bun", "version_prefix": "1.4.", "ci_version": "1.4.0"}
  ],
  "integration": {"mode": "direct", "remote": "seed-hono-api", "update_strategy": "generator-update"},
  "capabilities": {
    "supported_databases": ["postgresql-managed"],
    "database_features": {"postgresql-managed": ["persistence"]},
    "feature_map": {
      "auth": "auth",
      "rbac": "authorization",
      "audit": "audit",
      "multitenancy": "tenancy",
      "jobs": "jobs",
      "notifications": {"to": ["notifications"], "requires": ["jobs"]},
      "observability": "observability",
      "api-keys": {"to": ["apiKeys"], "requires": ["multitenancy"]},
      "files": {"to": ["files"], "requires": ["multitenancy"]},
      "webhooks": {"to": ["webhooks"], "requires": ["multitenancy"]}
    },
    "unsupported_features": ["abac"]
  },
  "materializer": {
    "type": "git-generator",
    "destination": "services/api",
    "source_setup": [["bun", "install", "--frozen-lockfile"]],
    "command": ["bun", "run", "create:project", "--", "--features={features_csv}", "--out={output}"],
    "setup": [["bun", "install", "--frozen-lockfile"]],
    "checks": [
      {"gate": "lint", "command": ["bun", "run", "lint"]},
      {"gate": "typecheck", "command": ["bun", "run", "typecheck"]},
      {"gate": "test", "command": ["bun", "test", "--parallel=1"]}
    ]
  },
  "prune": [".github", "OPENCODE_*.md"]
}
