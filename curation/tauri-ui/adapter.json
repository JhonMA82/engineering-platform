{
  "schema_version": 1,
  "boilerplate_id": "tauri-ui",
  "reviewed_at": "2026-08-31",
  "source": {
    "repository": "https://github.com/agmmnn/tauri-ui",
    "branch": "main",
    "commit": "8eb86d894c19b6df04ff883ab28b412b1e5f23ea",
    "license": "MIT",
    "package": "create-tauri-ui@1.2.0"
  },
  "integration": {"mode": "overlay", "remote": "seed-tauri-ui", "update_strategy": "regenerate-and-diff"},
  "requirements": [
    {"executable": "bun", "version_prefix": "1.4.", "ci_version": "1.4.0"},
    {"executable": "node", "version_prefix": "24.", "ci_version": "24"}
  ],
  "extension_destination": "apps/desktop",
  "materializer": {
    "type": "git-generator",
    "destination": ".",
    "source_setup": [
      ["bun", "install", "--frozen-lockfile"],
      ["bun", "run", "--cwd", "packages/create-tauri-ui", "build"]
    ],
    "source_patches": ["curation/tauri-ui/patches/create-tauri-app-version.patch"],
    "command": ["node", "packages/create-tauri-ui/index.js", "{output}", "--template", "vite", "--yes", "--no-workflow"],
    "setup": [["bun", "install", "--frozen-lockfile"]],
    "checks": [{"gate": "build", "command": ["bun", "run", "build"]}]
  },
  "overlay": "curation/tauri-ui/overlay"
}
