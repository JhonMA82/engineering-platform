{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/schemas/golden-paths.schema.json",
  "title": "Project recipes",
  "type": "object",
  "required": ["schema_version", "platform_version", "paths"],
  "properties": {
    "schema_version": {"const": 2},
    "platform_version": {"type": "string"},
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "name", "match", "stack", "features", "skills", "gates", "exclusions", "example"],
        "properties": {
          "id": {"type": "string", "pattern": "^GP-[0-9]{2}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["stable", "trial", "deprecated"]},
          "match": {
            "type": "object",
            "required": ["project_types", "signals"],
            "properties": {
              "project_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "signals": {"type": "array", "items": {"type": "string"}}
            }
          },
          "skills": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "composable_surfaces": {
            "type": "array",
            "description": "Surfaces que esta Recipe permite componer además de sus starters primarios; el provider se resuelve entre los boilerplates que declaran provides_surfaces.",
            "items": {"type": "string", "enum": ["public-web", "public-intake", "mobile", "desktop"]},
            "uniqueItems": true
          },
          "exclusions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
