{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/schemas/feature-packs.schema.json",
  "title": "Feature packs",
  "type": "object",
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": {"const": 2},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "requires", "skills", "gates", "example"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["planned", "pilot-ready", "released", "experimental", "deprecated"]},
          "requires": {"type": "array", "items": {"type": "string"}},
          "skills": {"type": "array", "items": {"type": "string"}},
          "gates": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
