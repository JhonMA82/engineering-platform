{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform/schemas/materialization-plan.schema.json",
  "title": "MaterializationPlan",
  "type": "object",
  "required": ["schema_version", "project", "recipe", "components", "database_profile"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string", "minLength": 1 },
    "recipe": { "type": "string", "minLength": 1 },
    "recipe_version": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["boilerplate", "pin", "destination", "surface"],
        "properties": {
          "boilerplate": { "type": "string", "minLength": 1 },
          "pin": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 }
        }
      }
    },
    "database_profile": { "type": "string", "minLength": 1 },
    "operations": { "type": "array", "items": { "type": "string" } },
    "setup": { "type": "array", "items": { "type": "string" } },
    "checks": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string" }
  }
}
