{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/schemas/project-definition.schema.json",
  "title": "Confirmed project definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea", "intake", "delivery", "discovery"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "idea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "problem", "users", "outcomes", "must_have", "out_of_scope"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "problem": {"type": "string", "minLength": 1},
        "users": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_have": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "intake": {"$ref": "./intake.schema.json"},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_criteria", "risks", "unknowns"],
      "properties": {
        "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_by", "confirmed_at"],
      "properties": {
        "status": {"const": "confirmed"},
        "confirmed_by": {"const": "user"},
        "confirmed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
